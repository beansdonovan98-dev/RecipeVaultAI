# Use the public anon key only. Never ship the service_role or secret key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Recipe Creator (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# The key is not tied to a model version; the app picks a Flash model automatically.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
# Optional: force a specific model instead of the automatic choice.
# Leave this unset unless you need to pin one; retired models fall back automatically.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
